rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdminEmail() {
      return request.auth != null && (
        request.auth.token.email == "marketing.ionlab@gmail.com" ||
        request.auth.token.email == "tiago336699@gmail.com" ||
        request.auth.token.email == "TIAGO336699@GMAIL.COM"
      );
    }

    function isAdmin() {
      return request.auth != null && (
        isAdminEmail() ||
        request.auth.token.admin == true ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Public content used by the website.
    // Everyone can read, only authenticated admins can write.
    match /videos/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /fotos/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /catalogos/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /manuais/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Optional: keep admin profile docs private to admins only.
    match /admins/{uid} {
      allow read, write: if isAdmin();
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
